rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email in [
          // Replace with the exact admin email, OR use an admin UID allowlist.
          "REPLACE_WITH_ADMIN_EMAIL"
        ];
    }

    match /members/{uid} {
      // A customer can read/write only their own anonymous-auth profile.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.stamps == 0
        && request.resource.data.rewardIssued == false
        && request.resource.data.keys().hasOnly(['uid','name','phone','stamps','rewardIssued','joinedAt']);
      // Customers may update their own name/phone, but cannot alter stamps/reward.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.stamps == resource.data.stamps
          && request.resource.data.rewardIssued == resource.data.rewardIssued
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone']))
        || (isAdmin()
          && request.resource.data.stamps >= resource.data.stamps
          && request.resource.data.stamps <= 5
          && request.resource.data.rewardIssued in [true,false])
      );
      allow delete: if isAdmin();
    }
  }
}
